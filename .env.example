# Teammates who text from numbers Dialpad doesn't know as users (personal cells, etc.).
# Comma-separated; these numbers are never looked up in Copper.
TEAM_PHONE_NUMBERS=

# --- LLM -------------------------------------------------------------------
# Local Ollama (check the exact tag with `ollama list` after `ollama pull`).
#   qwen3.8:27b  Qwen3.8 (Aug 2026), ~18 GB at Q4: needs a 24 GB GPU
#   qwen3:8b     Qwen3-8B (2025), ~5 GB: fits 8 GB GPUs
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.8:27b
# OpenRouter (comment out the three lines above; confirm slugs at https://openrouter.ai/models):
#   qwen/qwen3.8-27b, or the cheaper qwen/qwen3.8-flash
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_API_KEY=
# OpenRouter only: "deny" routes only to providers that don't store or train on prompts.
LLM_DATA_COLLECTION=deny

# Qwen's model card suggests temperature 0.7, top_p 0.8, top_k 20 for non-thinking mode; low
# temperature is usually steadier for factual notes. Worth comparing both.
LLM_TEMPERATURE=0.2
LLM_TOP_P=
LLM_TOP_K=
LLM_MAX_TOKENS=800
# Ollama context window in tokens. Its default is 4096 on GPUs under 24 GB and longer prompts are
# cut off with only a debug log. Keep it fixed: changing it between calls reloads the model.
LLM_NUM_CTX=16384
# Qwen3-family models reason before answering unless this is false.
LLM_THINK=false
LLM_TIMEOUT_SECONDS=300
