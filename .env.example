# Teammates who text from numbers Dialpad doesn't know as users (personal cells, etc.).
# Comma-separated; these numbers are never looked up in Copper.
TEAM_PHONE_NUMBERS=

# --- LLM -------------------------------------------------------------------
# Local Ollama:
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=
# OpenRouter (comment out the three lines above):
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=
# LLM_API_KEY=

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
# Ollama context window in tokens. Its default is small and long prompts are silently cut off.
LLM_NUM_CTX=16384
# Qwen3-family models reason before answering unless this is false.
LLM_THINK=false
LLM_TIMEOUT_SECONDS=300
